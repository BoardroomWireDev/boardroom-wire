{
  "name": "boardroom-wire",
  "version": "0.0.1",
  "description": "Boardroom Wire — strategic analysis of business and technology.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "globe:data": "node scripts/build-globe-data.mjs",
    "astro": "astro",
    "sync:dashboards": "node scripts/sync-dashboards.mjs",
    "render:posters": "node scripts/render-posters.mjs",
    "analytics:refresh": "node scripts/sync-dashboards.mjs && node scripts/render-posters.mjs",
    "edge": "astro build && wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply bw-data --local",
    "db:remote": "wrangler d1 migrations apply bw-data --remote",
    "cf:history": "node scripts/cf-history.mjs",
    "collector:deploy": "wrangler deploy --config collector/wrangler.toml",
    "collector:logs": "wrangler d1 execute bw-data --remote --command \"SELECT datetime(ts/1000,'unixepoch') at, job, ok, detail FROM collector_runs ORDER BY ts DESC LIMIT 10\""
  },
  "dependencies": {
    "astro": "^5.18.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@cloudflare/workers-types": "^5.20260927.1",
    "sharp": "^0.34.5",
    "wrangler": "^4.142.0"
  }
}
