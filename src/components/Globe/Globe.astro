---
/**
 * <Globe /> — the homepage globe (v2, 27 Sep 2026).
 *
 * Layout: wide screens see a HORIZON (the planet ~1.3× the screen wide, its limb arcing across
 * the page, a gold atmosphere brightest where the real sun is); phones and portrait screens see
 * the whole planet in ORBIT. scene.ts picks per resize. Capitals whose exchange is in its regular
 * session breathe. One centred status row sits under the nav: the UTC clock, how many exchanges are
 * in session (or, when none are, the next opening bell), and the pause control as an icon button.
 *
 * Motion: readers who prefer reduced motion get a calm globe (slower spin, no swoops, ripples,
 * drift or parallax), not a frozen one; everyone gets a Pause control, remembered per browser.
 *
 * Paint order: a poster still (the LCP) → when the globe is in view and the browser is idle,
 * scene.ts is imported and draws → the canvas crossfades in over the poster. Phones and touch
 * screens get the lite tier (coarser dots, one orbit, no dust); data-saver, ≤2 GB devices and
 * browsers without WebGL2 keep the poster. Keyboard and screen-reader users get the capitals as
 * a list of buttons: Tab / ← → move between them and drive the globe, Enter selects, Esc resets.
 */
import { CAPITALS } from './capitals';
const westToEast = CAPITALS.map((c, i) => ({ ...c, i })).sort((a, b) => a.lng - b.lng);
---

<div class="gv2" id="gv2" data-state="poster">
  <picture>
    <source media="(max-width: 720px), (max-aspect-ratio: 1/1)" srcset="/globe/poster-m.jpg" />
    <img class="gv2-poster" src="/globe/poster.jpg" alt="" width="1600" height="800" fetchpriority="high" decoding="async" />
  </picture>
  <div class="gv2-canvas" id="gv2-canvas"></div>
  <div class="gv2-label" id="gv2-label" aria-hidden="true"></div>
  <div class="gv2-status">
    <p class="gv2-caption" id="gv2-caption" aria-hidden="true"></p>
    <p class="gv2-markets" id="gv2-markets" aria-hidden="true" title="Regular trading hours. Public holidays are not reflected."></p>
    <button type="button" class="gv2-pause" id="gv2-pause" aria-pressed="false" aria-label="Pause globe motion" title="Pause globe motion">
      <svg viewBox="0 0 12 12" aria-hidden="true"><path class="i-pause" d="M3 2.5h2v7H3zM7 2.5h2v7H7z" /><path class="i-play" d="M4 2.2 10 6l-6 3.8z" /></svg>
    </button>
  </div>
  <ol class="gv2-list" aria-label="Tech capitals on the globe">
    {westToEast.map((c) => <li><button type="button" data-i={c.i}>{c.name}: {c.role}</button></li>)}
  </ol>
  <p class="gv2-sr" aria-live="polite" id="gv2-live"></p>
</div>

<style>
  .gv2 {
    position: relative;
    width: 100vw;
    height: clamp(560px, 88vh, 1000px);
    margin-top: clamp(-90px, -4vw, -30px);
    margin-bottom: clamp(-80px, -3vw, -20px);
  }
  .gv2-poster, .gv2-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 13%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 13%);
  }
  .gv2-poster { object-fit: cover; object-position: 50% 0; transition: opacity 0.9s ease; }   /* the horizon still: keep the limb's height */
  .gv2-canvas { opacity: 0; transition: opacity 0.9s ease; }
  .gv2[data-state='live'] .gv2-canvas { opacity: 1; }
  .gv2[data-state='live'] .gv2-poster { opacity: 0; }
  .gv2-canvas :global(canvas) { display: block; width: 100%; height: 100%; }

  /* The label plate: IBM Plex Mono for the code and clock, Inter for the words. */
  .gv2-label {
    position: absolute; left: 0; top: 0; z-index: 3;
    max-width: 270px; padding: 12px 15px 13px;
    background: rgba(8, 8, 10, 0.9); border: 1px solid rgba(255, 179, 71, 0.28); border-left: 2px solid #FFB347;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 179, 71, 0.12);
    text-align: left; pointer-events: none;
    opacity: 0; transition: opacity 0.18s ease;
  }
  .gv2-label.left { border-left: 1px solid rgba(255, 179, 71, 0.28); border-right: 2px solid #FFB347; }
  .gv2-label:global(.on) { opacity: 1; }
  .gv2-label :global(.lp-top) { display: flex; gap: 10px; align-items: baseline; font: 500 11px/1 var(--mono, monospace); letter-spacing: 0.14em; color: #888173; }
  .gv2-label :global(.lp-code) { color: #F2CB52; font-weight: 600; letter-spacing: 0.18em; }
  .gv2-label :global(.lp-dn) { margin-left: auto; color: #FFB347; }
  .gv2-label :global(.lp-name) { margin-top: 8px; font: 800 18px/1.15 var(--display, sans-serif); color: #F5F1E5; letter-spacing: -0.01em; }
  .gv2-label :global(.lp-role) { margin-top: 4px; font: 700 10px/1.3 var(--display, sans-serif); letter-spacing: 0.2em; text-transform: uppercase; color: #FFB347; }
  .gv2-label :global(.lp-thesis) { margin-top: 8px; font: 400 13px/1.45 var(--display, sans-serif); color: #A9A497; }
  .gv2-label :global(.lp-mkt) { margin-top: 9px; padding-top: 8px; border-top: 1px solid rgba(255, 179, 71, 0.18); font: 500 10px/1.4 var(--mono, monospace); letter-spacing: 0.12em; color: #888173; }
  .gv2-label :global(.lp-mkt.open) { color: #FFC97A; }

  /* The status row, centred like the rest of the hero: clock · markets · pause. */
  .gv2-status {
    position: absolute; top: 9%; left: 50%; z-index: 3; transform: translateX(-50%);
    display: flex; align-items: center; gap: 14px; white-space: nowrap;
    font: 500 10.5px/1 var(--mono, monospace); letter-spacing: 0.22em; text-transform: uppercase; color: #888173;
    opacity: 0; transition: opacity 1.2s ease 0.6s;
  }
  .gv2[data-state='live'] .gv2-status { opacity: 1; }
  /* On the horizon the row sits on the planet's crest, 40px above the limb (scene.ts puts the limb at 27%). */
  .gv2:has(.gv2-canvas[data-layout='horizon']) .gv2-status { top: calc(27% - 40px); }
  .gv2-status p { text-shadow: 0 0 10px #000, 0 0 3px #000; }   /* legible over the glow when the sun is behind the planet */
  .gv2-status p { margin: 0; }
  .gv2-caption:empty { display: none; }
  .gv2-caption::after { content: '·'; margin-left: 14px; color: #5A5448; }
  .gv2-markets { display: flex; align-items: center; gap: 10px; }
  .gv2-markets::before {                              /* a hollow ring when the markets are shut, a beating amber dot when open */
    content: ''; width: 7px; height: 7px; box-sizing: border-box; border-radius: 50%; border: 1px solid #888173;
  }
  .gv2-markets[data-open='1'] { color: #FFB347; }
  .gv2-markets[data-open='1']::before { background: #FFB347; border-color: #FFB347; box-shadow: 0 0 8px rgba(255, 179, 71, 0.7); animation: gv2-beat 2.4s ease-in-out infinite; }
  .gv2-markets :global(.m-sep) { color: #5A5448; }
  .gv2-markets :global(.m-next) { color: #B9B3A3; }
  @keyframes gv2-beat { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .gv2-markets[data-open='1']::before { animation: none; } }

  /* Pause / play: a small ringed icon at the end of the row. The name stays constant; aria-pressed carries the state. */
  .gv2-pause {
    display: grid; place-items: center; width: 26px; height: 26px; padding: 0; margin-left: 2px;
    border-radius: 50%; background: rgba(10, 10, 15, 0.6); border: 1px solid rgba(212, 175, 55, 0.35);
    color: #A9A497; cursor: pointer; transition: color 0.18s, border-color 0.18s;
  }
  .gv2-pause svg { width: 10px; height: 10px; fill: currentColor; }
  .gv2-pause .i-play { display: none; }
  .gv2-pause[aria-pressed='true'] .i-pause { display: none; }
  .gv2-pause[aria-pressed='true'] .i-play { display: inline; }
  .gv2-pause:hover, .gv2-pause:focus-visible { color: #F2CB52; border-color: #F2CB52; }

  /* Visually hidden, but reachable: the capitals as buttons. */
  .gv2-list, .gv2-sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0; list-style: none;
  }

  @media (max-width: 720px) {
    .gv2 { width: 100vw; height: clamp(420px, 72vh, 640px); margin-top: -10px; }
    .gv2-label { max-width: 220px; }
    /* phones: the markets and the pause control only; when shut, just the next bell */
    .gv2-status { top: 2%; gap: 10px; font-size: 9.5px; letter-spacing: 0.12em; }
    .gv2-caption { display: none; }
    .gv2-markets[data-open='0'] :global(.m-lead), .gv2-markets[data-open='0'] :global(.m-sep) { display: none; }
    .gv2-pause { width: 30px; height: 30px; }
  }
</style>

<script>
  const root = document.getElementById('gv2')!;
  const host = document.getElementById('gv2-canvas')!;
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pauseBtn = document.getElementById('gv2-pause') as HTMLButtonElement;
  let paused = false;
  try { paused = localStorage.getItem('bw-globe-paused') === '1'; } catch {}
  const showPaused = () => { pauseBtn.setAttribute('aria-pressed', String(paused)); pauseBtn.title = paused ? 'Play globe motion' : 'Pause globe motion'; };
  showPaused();
  const weak = !!nav.connection?.saveData || (nav.deviceMemory !== undefined && nav.deviceMemory <= 2);
  const lite = innerWidth < 720 || matchMedia('(pointer: coarse)').matches;
  const gl2 = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();

  type Api = { hover(i: number | null): void; select(i: number | null): void; setPaused(p: boolean): void };
  let api: Api | null = null, starting = false;

  async function start() {
    if (api || starting || weak || !gl2) return;
    starting = true;
    try {
      const { createGlobe } = await import('./scene');
      api = await createGlobe({
        host, tier: lite ? 'lite' : 'full', calm, paused,
        palette: new URLSearchParams(location.search).get('palette') === 'v1' ? 'v1' : 'brand',
        label: document.getElementById('gv2-label')!,
        caption: document.getElementById('gv2-caption'),
        live: document.getElementById('gv2-live'),
        markets: document.getElementById('gv2-markets'),
        onFirstFrame: () => { root.dataset.state = 'live'; },
      });
    } catch (err) {
      console.warn('[globe] staying on the poster:', err);    // the still is a complete fallback
    }
  }
  const later = (fn: () => void) =>
    'requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150);
  const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); later(start); } });
  io.observe(root);

  // Keyboard: the hidden list drives the same hover / select as the pointer.
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('.gv2-list button')];
  buttons.forEach((b, k) => {
    const i = Number(b.dataset.i);
    b.addEventListener('focus', () => { start(); api?.hover(i); });
    b.addEventListener('blur', () => api?.hover(null));
    b.addEventListener('click', () => api?.select(i));
    b.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); buttons[(k + 1) % buttons.length].focus(); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); buttons[(k - 1 + buttons.length) % buttons.length].focus(); }
      if (e.key === 'Escape') { api?.select(null); b.blur(); }
    });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') api?.select(null); });

  pauseBtn.addEventListener('click', () => {
    paused = !paused; showPaused(); api?.setPaused(paused);
    try { localStorage.setItem('bw-globe-paused', paused ? '1' : '0'); } catch {}
  });
</script>
