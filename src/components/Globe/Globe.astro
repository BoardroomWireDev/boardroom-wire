---
/**
 * <Globe /> — the homepage globe (v2, 27 Sep 2026).
 *
 * Paint order: a poster still (the LCP) → when the globe is in view and the browser is idle,
 * scene.ts is imported and draws → the canvas crossfades in over the poster. Phones and touch
 * screens get the lite tier (coarser dots, one orbit, no dust); data-saver, ≤2 GB devices and
 * browsers without WebGL2 keep the poster. Keyboard and screen-reader users get the capitals as
 * a list of buttons: Tab / ← → move between them and drive the globe, Enter selects, Esc resets.
 */
import { CAPITALS } from './capitals';
const westToEast = CAPITALS.map((c, i) => ({ ...c, i })).sort((a, b) => a.lng - b.lng);
---

<div class="gv2" id="gv2" data-state="poster">
  <picture>
    <source media="(max-width: 720px)" srcset="/globe/poster-m.jpg" />
    <img class="gv2-poster" src="/globe/poster.jpg" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" />
  </picture>
  <div class="gv2-canvas" id="gv2-canvas"></div>
  <div class="gv2-label" id="gv2-label" aria-hidden="true"></div>
  <p class="gv2-caption" id="gv2-caption" aria-hidden="true"></p>
  <ol class="gv2-list" aria-label="Tech capitals on the globe">
    {westToEast.map((c) => <li><button type="button" data-i={c.i}>{c.name}: {c.role}</button></li>)}
  </ol>
  <p class="gv2-sr" aria-live="polite" id="gv2-live"></p>
</div>

<style>
  .gv2 {
    position: relative;
    width: min(1400px, 100vw);
    height: clamp(560px, 88vh, 1000px);
    margin-top: clamp(-90px, -4vw, -30px);
    margin-bottom: clamp(-80px, -3vw, -20px);
  }
  .gv2-poster, .gv2-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .gv2-poster { object-fit: cover; transition: opacity 0.9s ease; }
  .gv2-canvas { opacity: 0; transition: opacity 0.9s ease; }
  .gv2[data-state='live'] .gv2-canvas { opacity: 1; }
  .gv2[data-state='live'] .gv2-poster { opacity: 0; }
  .gv2-canvas :global(canvas) { display: block; width: 100%; height: 100%; }

  /* The label plate: IBM Plex Mono for the code and clock, Inter for the words. */
  .gv2-label {
    position: absolute; left: 0; top: 0; z-index: 3;
    max-width: 270px; padding: 12px 15px 13px;
    background: rgba(8, 8, 10, 0.9); border: 1px solid rgba(255, 179, 71, 0.28); border-left: 2px solid #FFB347;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 179, 71, 0.12);
    text-align: left; pointer-events: none;
    opacity: 0; transition: opacity 0.18s ease;
  }
  .gv2-label.left { border-left: 1px solid rgba(255, 179, 71, 0.28); border-right: 2px solid #FFB347; }
  .gv2-label:global(.on) { opacity: 1; }
  .gv2-label :global(.lp-top) { display: flex; gap: 10px; align-items: baseline; font: 500 11px/1 var(--mono, monospace); letter-spacing: 0.14em; color: #888173; }
  .gv2-label :global(.lp-code) { color: #F2CB52; font-weight: 600; letter-spacing: 0.18em; }
  .gv2-label :global(.lp-dn) { margin-left: auto; color: #FFB347; }
  .gv2-label :global(.lp-name) { margin-top: 8px; font: 800 18px/1.15 var(--display, sans-serif); color: #F5F1E5; letter-spacing: -0.01em; }
  .gv2-label :global(.lp-role) { margin-top: 4px; font: 700 10px/1.3 var(--display, sans-serif); letter-spacing: 0.2em; text-transform: uppercase; color: #FFB347; }
  .gv2-label :global(.lp-thesis) { margin-top: 8px; font: 400 13px/1.45 var(--display, sans-serif); color: #A9A497; }

  .gv2-caption {
    position: absolute; top: 9%; right: max(24px, 8%); z-index: 2; text-align: right;
    font: 500 11px/1 var(--mono, monospace); letter-spacing: 0.22em; color: #888173; white-space: nowrap;
    opacity: 0; transition: opacity 1.2s ease 0.6s; pointer-events: none;
  }
  .gv2[data-state='live'] .gv2-caption { opacity: 0.85; }

  /* Visually hidden, but reachable: the capitals as buttons. */
  .gv2-list, .gv2-sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0; list-style: none;
  }

  @media (max-width: 720px) {
    .gv2 { width: 100vw; height: clamp(420px, 72vh, 640px); margin-top: -10px; }
    .gv2-label { max-width: 220px; }
    .gv2-caption { top: 2%; right: 50%; transform: translateX(50%); font-size: 10px; letter-spacing: 0.16em; }
  }
</style>

<script>
  const root = document.getElementById('gv2')!;
  const host = document.getElementById('gv2-canvas')!;
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const weak = !!nav.connection?.saveData || (nav.deviceMemory !== undefined && nav.deviceMemory <= 2);
  const lite = innerWidth < 720 || matchMedia('(pointer: coarse)').matches;
  const gl2 = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();

  type Api = { hover(i: number | null): void; select(i: number | null): void };
  let api: Api | null = null, starting = false;

  async function start() {
    if (api || starting || weak || !gl2) return;
    starting = true;
    try {
      const { createGlobe } = await import('./scene');
      api = await createGlobe({
        host, tier: lite ? 'lite' : 'full', reduced,
        label: document.getElementById('gv2-label')!,
        caption: document.getElementById('gv2-caption'),
        live: document.getElementById('gv2-live'),
        onFirstFrame: () => { root.dataset.state = 'live'; },
      });
    } catch (err) {
      console.warn('[globe] staying on the poster:', err);    // the still is a complete fallback
    }
  }
  const later = (fn: () => void) =>
    'requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150);
  const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); later(start); } });
  io.observe(root);

  // Keyboard: the hidden list drives the same hover / select as the pointer.
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('.gv2-list button')];
  buttons.forEach((b, k) => {
    const i = Number(b.dataset.i);
    b.addEventListener('focus', () => { start(); api?.hover(i); });
    b.addEventListener('blur', () => api?.hover(null));
    b.addEventListener('click', () => api?.select(i));
    b.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); buttons[(k + 1) % buttons.length].focus(); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); buttons[(k - 1 + buttons.length) % buttons.length].focus(); }
      if (e.key === 'Escape') { api?.select(null); b.blur(); }
    });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') api?.select(null); });
</script>
