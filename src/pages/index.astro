---
import SeoHead from '../components/SeoHead.astro';
import Globe from '../components/Globe/Globe.astro';
import { SITE_ORIGIN } from '../data/analytics';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Boardroom Wire', url: SITE_ORIGIN, logo: `${SITE_ORIGIN}/logo.png`,
    sameAs: ['https://www.youtube.com/@BoardroomWire', 'https://x.com/BoardroomWire', 'https://boardroomwire.substack.com/'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Boardroom Wire', url: SITE_ORIGIN },
];
// Homepage — the hero (wordmark, tagline, nav) over the globe.
// YouTube data and channel ID live in src/lib/youtube.ts; this page just
// imports fetchChannelData() from there in the body script.
---

<!doctype html>
<html lang="en">
<head>
  <SeoHead title="Boardroom Wire — Strategic Analysis. Business & Technology." description="Strategic analysis of business and technology: filing-first video investigations and interactive dashboards on the companies shaping AI and finance." path="/" jsonLd={jsonLd} />

  <style>
    :root {
      --black:       #000000;
      --black-soft:  #0A0A0A;
      --line:        #1A1A1A;

      --white:       #F5F1E5;
      --white-dim:   #888173;

      --gold:        #D4AF37;
      --gold-bright: #F2CB52;

      /* Phosphor amber — for emissive elements (pulsing, glowing, on-air).
         Static UI stays on --gold; anything that emits light uses --amber. */
      --amber:        #FFB347;
      --amber-bright: #FFC97A;
      --amber-glow:   rgba(255, 179, 71, 0.4);

      --display: 'Inter', system-ui, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--black);
      color: var(--white);
      font-family: var(--display);
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Subtle film-grain overlay */
    body::before {
      content: "";
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 1000;
      opacity: 0.04;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/%3E%3C/svg%3E");
    }

    /* ============ TICKER ============ */
    .ticker {
      display: flex;
      align-items: stretch;
      height: 54px;
      border-bottom: 1px solid var(--line);
      background: var(--black);
      position: relative;
      z-index: 10;
    }
    .ticker-label {
      background: var(--gold);
      color: var(--black);
      font-family: var(--display);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.24em;
      padding: 0 22px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-transform: uppercase;
      /* Faint amber halo so the gold chip reads as "lit" alongside the
         globe's bloom — tiny, not glowy. */
      box-shadow: 0 0 14px var(--amber-glow);
    }
    .ticker-label .pulse {
      width: 9px; height: 9px;
      background: #FF3B30;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7);
      filter: drop-shadow(0 0 4px rgba(255, 59, 48, 0.55));
      animation: pulse-red 1.4s ease-in-out infinite;
    }
    @keyframes pulse-red {
      0%   { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); opacity: 1; }
      70%  { box-shadow: 0 0 0 10px rgba(255, 59, 48, 0); opacity: 0.85; }
      100% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); opacity: 1; }
    }
    .ticker-stats {
      flex: 1;
      overflow: hidden;
      position: relative;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
    }
    .ticker-track {
      display: flex;
      align-items: center;
      gap: 56px;
      height: 100%;
      width: max-content;
      padding-left: 32px;
      animation: ticker-scroll 28s linear infinite;
    }
    .ticker:hover .ticker-track,
    .ticker:focus-within .ticker-track {
      animation-play-state: paused;
    }
    @keyframes ticker-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .stat {
      font-family: var(--display);
      font-size: 13px;
      letter-spacing: 0.18em;
      color: var(--white-dim);
      text-transform: uppercase;
      font-weight: 500;
      display: flex;
      align-items: baseline;
      gap: 12px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .stat .v {
      color: var(--white);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .stat.live .v.on  { color: var(--gold-bright); }
    .stat.live .v.off { color: var(--white-dim); }
    .stat .sep {
      color: var(--line);
      margin-left: 56px;
    }

    /* ============ HERO ============ */
    main.hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 56px 24px 80px;
      min-height: calc(100vh - 54px - 80px);
      position: relative;
      z-index: 5;
    }
    .wordmark {
      font-family: var(--display);
      font-weight: 900;
      font-size: clamp(48px, 9vw, 112px);
      line-height: 0.95;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 32px;
      user-select: none;
      opacity: 0;
      animation: fadeUp 0.9s ease-out 0.1s forwards;
    }
    .wordmark .wire { color: var(--gold-bright); }
    /* Brand tagline — the wordmark's subtitle, centred directly under it. The two
       phrases never split internally; on a phone they stack as two lines. */
    .tagline-row {
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(14px, 1.4vw, 18px);
      line-height: 1.3;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--white);
      text-align: center;
    }
    .tagline-row span,
    .tagline-row em { white-space: nowrap; }
    .tagline-row em {
      font-style: normal;
      font-weight: 700;
      color: var(--gold-bright);
    }

    /* Two centred rows under the wordmark: the tagline, then socials + the nav
       buttons. (Until 27 Sep 2026 this was one 1480px row under a 1024px
       wordmark: off-centre at 1920, clipped at both ends by 1280.) */
    .find-row {
      width: 100%;
      max-width: 1080px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-bottom: 8px;
      opacity: 0;
      animation: fadeUp 0.9s ease-out 0.3s forwards;
      /* Above the globe canvas — the negative-margin pull on the globe band
         makes the canvas overlap this row, and we need the favicon clicks
         to land on the row, not on the (transparent) canvas above them. */
      position: relative;
      z-index: 2;
    }
    .find-row-right {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 20px 36px;
    }
    .hero-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
    }
    .find-us-label {
      font-family: var(--display);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.28em;
      color: var(--white-dim);
      text-transform: uppercase;
    }
    .socials {
      display: flex;
      gap: 22px;
      align-items: center;
    }
    .socials a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      color: var(--white);
      transition: all 0.2s;
      text-decoration: none;
    }
    .socials a:hover {
      color: var(--gold-bright);
      transform: translateY(-2px);
    }
    .socials svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }
    .more-info {
      display: inline-block;
      font-family: var(--display);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.24em;
      color: var(--black);
      text-transform: uppercase;
      text-decoration: none;
      background: var(--gold-bright);
      border: none;
      padding: 18px 36px;
      transition: all 0.2s;
      white-space: nowrap;
      box-shadow: 0 4px 0 0 var(--gold);
    }
    .more-info:hover {
      background: var(--gold);
      box-shadow: 0 6px 0 0 #b8932e, 0 0 24px var(--amber-glow);
      transform: translateY(-2px);
    }
    .more-info:active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 0 var(--gold);
    }

    /* Footer */
    footer.tail {
      border-top: 1px solid var(--line);
      padding: 28px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      font-family: var(--display);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--white-dim);
    }
    footer.tail a {
      color: inherit;
      text-decoration: none;
      transition: color 0.18s;
    }
    footer.tail a:hover { color: var(--gold-bright); }
    .foot-links { display: flex; flex-wrap: wrap; gap: 22px; }

    /* Animations */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    /* Responsive */
    @media (max-width: 720px) {
      .ticker { height: 46px; }
      .ticker-track { gap: 36px; padding-left: 20px; }
      .stat { font-size: 11px; letter-spacing: 0.12em; gap: 8px; }
      .stat .sep { margin-left: 36px; }
      .ticker-label { font-size: 11px; padding: 0 14px; gap: 8px; }
      .ticker-label .pulse { width: 8px; height: 8px; }
      main.hero { padding: 40px 24px 64px; }
      /* The wordmark runs ~9.2x its font size wide; 9.2vw keeps it inside the
         24px gutters (12vw ran it off both edges of a 390px phone). */
      .wordmark { font-size: clamp(28px, 9.2vw, 64px); margin-bottom: 24px; }
      .find-row { gap: 20px; margin-bottom: 12px; }
      .tagline-row { font-size: 13px; letter-spacing: 0.18em; }
      .tagline-row em { display: block; margin-top: 4px; }
      .find-row-right { flex-direction: column; gap: 18px; }
      .socials { gap: 20px; }
      .hero-nav { gap: 10px; }
      .more-info { font-size: 12px; letter-spacing: 0.18em; padding: 14px 18px; }
      footer.tail { padding: 20px 24px; flex-direction: column; align-items: flex-start; gap: 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      /* Heavy motion (globe rotation, carousel autoplay, hero fades) respects
         the preference. The ticker keeps animating — it's a horizontal text
         crawl, not the kind of vestibular trigger this preference targets. */
      *, *::before, *::after {
        animation-duration: 0s !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0s !important;
      }
      .ticker-track {
        animation: ticker-scroll 28s linear infinite !important;
      }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- Live Wire ticker -->
  <div class="ticker">
    <div class="ticker-label">
      <span class="pulse"></span>
      <span>Live Wire</span>
    </div>
    <div class="ticker-stats" aria-label="Live channel statistics">
      <div class="ticker-track">
        <div class="stat">Videos <span class="v" data-stat="videos">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Subscribers <span class="v" data-stat="subs">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Total Views <span class="v" data-stat="views">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Top Episode <span class="v" data-stat="top">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Newest <span class="v" data-stat="newest">—</span><span class="sep" aria-hidden="true">·</span></div>
        <!-- Duplicate set for seamless marquee loop -->
        <div class="stat" aria-hidden="true">Videos <span class="v" data-stat="videos">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Subscribers <span class="v" data-stat="subs">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Total Views <span class="v" data-stat="views">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Top Episode <span class="v" data-stat="top">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Newest <span class="v" data-stat="newest">—</span><span class="sep">·</span></div>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <main id="main" class="hero">
    <h1 class="wordmark" aria-label="Boardroom Wire">
      BOARDROOM<span class="wire">WIRE</span>
    </h1>

    <div class="find-row">
      <p class="tagline-row"><span>Strategic Analysis.</span> <em>Business &amp; Technology.</em></p>
      <div class="find-row-right">
        <div class="socials">
          <a href="https://x.com/BoardroomWire" target="_blank" rel="noopener" title="X" aria-label="X">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.youtube.com/@BoardroomWire" target="_blank" rel="noopener" title="YouTube" aria-label="YouTube">
            <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://boardroomwire.substack.com/" target="_blank" rel="noopener" title="Substack" aria-label="Substack">
            <svg viewBox="0 0 24 24"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
          </a>
        </div>
        <nav class="hero-nav" aria-label="Site">
          <a href="/wire/" class="more-info">Wire</a>
          <a href="/videos/" class="more-info">Videos</a>
          <a href="/about/" class="more-info">About</a>
        </nav>
      </div>
    </div>

    <Globe />
  </main>

  <footer class="tail">
    <span>© {new Date().getFullYear()} Boardroom Wire</span>
    <span class="foot-links"><a href="/wire/">Wire</a><a href="/videos/">Videos</a><a href="/about/">About</a><a href="https://boardroomwire.substack.com/" target="_blank" rel="noopener">Substack</a></span>
  </footer>

  <!-- YouTube live data — both ticker and reel feed off one cached fetch -->
  <script>
    import { fetchChannelData, fmt, daysAgo } from '../lib/youtube';

    const setStat = (name: string, value: string) => {
      document.querySelectorAll(`[data-stat="${name}"]`).forEach((el) => {
        el.textContent = value;
      });
    };

    async function hydrate() {
      const data = await fetchChannelData();
      if (!data) return; // ticker keeps em-dashes
      setStat('videos', fmt(data.videos));
      setStat('subs',   fmt(data.subs));
      setStat('views',  fmt(data.views));
      setStat('top',    data.topVideo ? `${fmt(data.topVideo.views)} views` : '—');
      setStat('newest', data.newest ? daysAgo(data.newest.publishedAt) : '—');
    }
    hydrate();
    // Refresh every 30 minutes (the cache lifetime in src/lib/youtube.ts)
    setInterval(hydrate, 30 * 60_000);
  </script>

  <!-- globe.gl hero globe — capital-markets cities + arcs + rings + click-to-emit -->

</body>
</html>
