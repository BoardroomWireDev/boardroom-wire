---
import Site from '../layouts/Site.astro';
---

<Site
  title="Not found · Boardroom Wire"
  description="That page doesn't exist."
  pageLabel="404"
  path="/404/"
  noindex
>
  <main class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1 class="hd">Nothing filed <span class="dim">at this address.</span></h1>
    <p class="lede">The page you asked for doesn't exist, or it moved. Try one of these.</p>
    <div class="rule"></div>
    <nav class="links">
      <a href="/wire/">The Wire — articles</a>
      <a href="/analytics/">Analytics — dashboards</a>
      <a href="/videos/">Videos</a>
      <a href="/about/">About</a>
      <a href="/">Home</a>
    </nav>
  </main>
</Site>

<style>
  .links { display: flex; flex-direction: column; gap: 14px; }
  .links a {
    font-size: 15px; font-weight: 700; letter-spacing: 0.06em;
    color: var(--gold-bright); text-decoration: none;
  }
  .links a:hover { color: var(--white); }
</style>
