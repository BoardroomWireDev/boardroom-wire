---
/**
 * /analytics/situational-awareness/<slug>/ — one page per dashboard.
 *
 * The dashboards are authored as fixed 1920x1080 stages for video capture, so
 * the embed is scaled rather than reflowed:
 *
 *   desktop  the live dashboard in an iframe, CSS-scaled to the container.
 *            The iframe src is set only when it scrolls into view, so the
 *            reveal animation fires when the reader arrives rather than
 *            finishing off-screen — and GSAP isn't fetched until needed.
 *
 *   mobile   the poster still, tappable to open full-size where the browser
 *            gives native pinch-zoom. Scaling a 1920px stage to phone width
 *            renders the 12.5px source lines at ~2.5px, which is unreadable,
 *            so the live version is desktop-only by design.
 *
 * The poster doubles as the placeholder behind the iframe while it loads.
 */
import Analytics from '../../../layouts/Analytics.astro';
import {
  situationalAwareness as c,
  embedPath, posterPath, ogPath,
} from '../../../data/analytics';

export function getStaticPaths() {
  return c.dashboards.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;

const idx = c.dashboards.findIndex((x) => x.slug === d.slug);
const prev = idx > 0 ? c.dashboards[idx - 1] : null;
const next = idx < c.dashboards.length - 1 ? c.dashboards[idx + 1] : null;

const title = `${d.title} · Situational Awareness · Boardroom Wire`;
---

<Analytics
  title={title}
  description={d.blurb}
  pageLabel="Analytics"
  path={`/analytics/${c.slug}/${d.slug}/`}
  ogImage={ogPath(c, d)}
>
  <main class="wrap">
    <a class="crumb" href={`/analytics/${c.slug}/`}>← Situational Awareness</a>

    <div class="head">
      <div>
        <p class="eyebrow">
          {String(d.n).padStart(2, '0')} / {c.dashboards.length} · {d.section}
        </p>
        <h1 class="hd">{d.title}</h1>
      </div>
      <span class={`chip ${d.source}`}>
        {d.source === 'primary' ? 'SEC primary' : 'Reported'}
      </span>
    </div>

    <p class="lede">{d.blurb}</p>

    <!-- ===== the embed ===== -->
    <figure
      class="stage"
      id="stage"
      data-embed={embedPath(c, d)}
      data-title={d.title}
    >
      <div class="scaler" id="scaler"></div>

      <a class="poster-link" id="poster-link" href={posterPath(c, d)}>
        <img
          class="poster"
          id="poster"
          src={posterPath(c, d)}
          alt={`${d.title} — dashboard`}
          width="1920" height="1080"
          decoding="async"
        />
      </a>

      <span class="tap-hint">Tap to enlarge</span>
    </figure>

    <div class="controls" id="controls" hidden>
      <button type="button" id="replay">↻ Replay</button>
      <button type="button" id="full">⤢ Fullscreen</button>
      <a href={embedPath(c, d)} target="_blank" rel="noopener">Open standalone ↗</a>
    </div>

    <p class="srcnote"><span>Source</span>{d.sourceNote}</p>

    <nav class="pager" aria-label="Other dashboards">
      {prev
        ? <a class="pg prev" href={`/analytics/${c.slug}/${prev.slug}/`}>
            <span class="pg-k">← Previous</span>
            <span class="pg-t">{prev.title}</span>
          </a>
        : <span></span>}
      {next
        ? <a class="pg next" href={`/analytics/${c.slug}/${next.slug}/`}>
            <span class="pg-k">Next →</span>
            <span class="pg-t">{next.title}</span>
          </a>
        : <span></span>}
    </nav>
  </main>
</Analytics>

<style>
  .head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .head .hd { font-size: clamp(26px, 3.6vw, 44px); }

  /* ---- stage ---- */
  .stage {
    position: relative;
    margin: 34px 0 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0a0a0f;
    border: 1px solid var(--line);
  }
  /* The dashboard is authored at exactly 1920x1080; --s is set by script to
     containerWidth / 1920 so it fills the box without reflowing. */
  .scaler {
    position: absolute; top: 0; left: 0;
    width: 1920px; height: 1080px;
    transform-origin: top left;
    transform: scale(var(--s, 1));
  }
  .scaler :global(iframe) {
    width: 1920px; height: 1080px;
    border: 0; display: block;
  }

  .poster-link { position: absolute; inset: 0; display: block; }
  .poster {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: opacity 0.45s ease;
  }
  .stage.live .poster { opacity: 0; pointer-events: none; }

  .tap-hint {
    position: absolute; right: 10px; bottom: 10px; z-index: 3;
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--amber); background: rgba(0, 0, 0, 0.72);
    border: 1px solid rgba(255, 179, 71, 0.4);
    padding: 5px 9px;
  }

  /* ---- controls ---- */
  .controls {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-top: 14px;
  }
  .controls button,
  .controls a {
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--white-dim); background: transparent;
    border: 1px solid var(--line); padding: 9px 14px;
    cursor: pointer; text-decoration: none;
    transition: color 0.18s, border-color 0.18s;
  }
  .controls button:hover,
  .controls a:hover { color: var(--gold-bright); border-color: rgba(212, 175, 55, 0.5); }

  /* ---- source ---- */
  .srcnote {
    margin-top: 26px; padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 12px; line-height: 1.75;
    letter-spacing: 0.03em; color: #8E8A7E;
  }
  .srcnote span {
    display: block; margin-bottom: 6px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--amber);
  }

  /* ---- pager ---- */
  .pager {
    display: flex; justify-content: space-between; gap: 18px;
    margin-top: 44px; padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  a.pg { text-decoration: none; color: var(--white); max-width: 46%; }
  a.pg.next { text-align: right; margin-left: auto; }
  .pg-k {
    display: block; font-family: var(--mono);
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--white-dim);
  }
  .pg-t {
    display: block; margin-top: 7px;
    font-size: 15px; font-weight: 700; line-height: 1.3;
  }
  a.pg:hover .pg-t { color: var(--amber-bright); }

  /* Desktop: the live embed takes over, so the poster link and tap hint go. */
  @media (min-width: 900px) {
    .poster-link { pointer-events: none; }
    .tap-hint { display: none; }
  }
  /* Mobile: no iframe is ever created, so the poster is the dashboard. */
  @media (max-width: 899px) {
    .controls { display: none !important; }
    .stage { margin-top: 24px; }
  }
</style>

<script>
  const stage = document.getElementById('stage') as HTMLElement | null;
  const scaler = document.getElementById('scaler') as HTMLElement | null;

  if (stage && scaler) {
    const src = stage.dataset.embed!;
    const label = stage.dataset.title ?? 'Dashboard';

    /** Below this the dashboard's own type is too small to read when scaled. */
    const MIN_LIVE_WIDTH = 900;
    const STAGE_W = 1920;

    const fit = () => {
      scaler.style.setProperty('--s', String(stage.clientWidth / STAGE_W));
    };
    fit();
    new ResizeObserver(fit).observe(stage);

    let frame: HTMLIFrameElement | null = null;

    const mount = () => {
      if (frame || window.innerWidth < MIN_LIVE_WIDTH) return;
      frame = document.createElement('iframe');
      frame.title = label;
      frame.loading = 'lazy';
      // Same-origin so Replay can reach contentWindow; no extra sandboxing
      // needed for our own static files.
      frame.setAttribute('scrolling', 'no');
      frame.addEventListener('load', () => stage.classList.add('live'), { once: true });
      frame.src = src;
      scaler.appendChild(frame);
      document.getElementById('controls')?.removeAttribute('hidden');
    };

    // Set src only once the stage is actually on screen, so the dashboard's
    // reveal animation plays for the reader instead of finishing off-screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { mount(); io.disconnect(); }
          }
        },
        { rootMargin: '200px 0px' },
      );
      io.observe(stage);
    } else {
      mount();
    }

    // If the viewport crosses the threshold after load, mount late.
    window.addEventListener('resize', () => {
      if (!frame && window.innerWidth >= MIN_LIVE_WIDTH) {
        const r = stage.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) mount();
      }
    });

    document.getElementById('replay')?.addEventListener('click', () => {
      if (!frame) return;
      stage.classList.remove('live');
      frame.addEventListener('load', () => stage.classList.add('live'), { once: true });
      // Cache-busting isn't wanted here — a plain reload replays the reveal.
      frame.contentWindow?.location.reload();
    });

    document.getElementById('full')?.addEventListener('click', () => {
      if (!document.fullscreenElement) stage.requestFullscreen?.();
      else document.exitFullscreen?.();
    });

    // In fullscreen the stage fills the viewport, so rescale against that.
    document.addEventListener('fullscreenchange', fit);
  }
</script>
