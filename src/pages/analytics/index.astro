---
/**
 * /analytics/ — the section landing page.
 *
 * One card per dashboard collection, newest first, built from
 * src/data/analytics.ts so the next video's set is an append, not a rewrite.
 */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { collections, heroOf, thumbPath, ogPath } from '../../data/analytics';

const title = 'Analytics · Boardroom Wire';
const description =
  'Interactive dashboards behind the Boardroom Wire investigations — built from primary filings, with every figure sourced on the frame.';

// The hub's own preview uses the newest collection's hero chart.
const hero = collections[0];

const articles = await getCollection('articles', (a) => (import.meta.env.PROD ? !a.data.draft : true));
const articleFor = (slug: string) => articles.find((a) => a.data.collection === slug);

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });
---

<Site
  title={title}
  description={description}
  pageLabel="Analytics"
  path="/analytics/"
  ogImage={ogPath(hero, heroOf(hero))}
>
  <main class="wrap">
    <p class="eyebrow">Research &amp; Analysis</p>
    <h1 class="hd">The charts behind <span class="dim">the reporting.</span></h1>
    <p class="lede">
      Every Boardroom Wire investigation is built on primary documents. These are the
      dashboards that came out of them — interactive, individually citable, and marked
      throughout with where each number came from.
    </p>

    <div class="rule"></div>

    <div class="collections">
      {collections.map((c) => {
        const article = articleFor(c.slug);
        return (
          <div class="coll">
            <a class="coll-img" href={`/analytics/${c.slug}/`}>
              <img
                src={thumbPath(c, heroOf(c))}
                alt=""
                width="640" height="360"
                loading="eager" decoding="async"
              />
            </a>
            <div class="coll-body">
              <p class="coll-kicker">{c.kicker} · {fmtDate(c.published)}</p>
              <h2><a href={`/analytics/${c.slug}/`}>{c.title}</a></h2>
              <p class="coll-sum">{c.summary}</p>
              <span class="coll-ctas">
                <a class="coll-cta" href={`/analytics/${c.slug}/`}>Open the collection →</a>
                {article && <a class="coll-cta alt" href={`/wire/${article.id}/`}>Read the article →</a>}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</Site>

<style>
  .collections { display: grid; gap: 26px; }

  .coll {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    color: var(--white);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 179, 71, 0.03), transparent 60%);
    padding: 26px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .coll:hover {
    border-color: rgba(255, 179, 71, 0.55);
    box-shadow: 0 0 26px rgba(255, 179, 71, 0.12);
  }

  .coll-img {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--black-soft);
  }
  .coll-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .coll:hover .coll-img img { transform: scale(1.04); }

  .coll-kicker {
    font-family: var(--mono);
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--amber);
  }
  .coll-body h2 {
    font-size: clamp(22px, 2.4vw, 30px); font-weight: 800;
    letter-spacing: -0.015em; line-height: 1.18; margin: 12px 0 0;
  }
  .coll-body h2 a { color: inherit; text-decoration: none; }
  .coll-body h2 a:hover { color: var(--amber-bright); }
  .coll-sum {
    font-size: 15px; line-height: 1.6; color: #9C978B; margin: 14px 0 0;
    max-width: 62ch;
  }
  .coll-ctas { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 18px; }
  .coll-cta {
    display: inline-block;
    font-size: 12px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold-bright); text-decoration: none;
  }
  .coll-cta.alt { color: var(--amber); }
  .coll-cta:hover { color: var(--white); }

  @media (max-width: 860px) {
    .coll { grid-template-columns: 1fr; gap: 20px; padding: 18px; }
  }
</style>
