---
/**
 * /analytics/ — the section landing page.
 *
 * One card per dashboard collection. Today that's a single collection; the
 * grid is built from src/data/analytics.ts so the next video's set is an
 * append, not a rewrite.
 */
import Analytics from '../../layouts/Analytics.astro';
import { collections, thumbPath, ogPath } from '../../data/analytics';

const title = 'Analytics · Boardroom Wire';
const description =
  'Interactive dashboards behind the Boardroom Wire investigations — built from primary filings, with every figure sourced on the frame.';

// The hub's own preview uses the strongest chart in the first collection.
const hero = collections[0];
const heroCard = hero.dashboards.find((d) => d.slug === 'seven-quarter-bridge') ?? hero.dashboards[0];

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });
---

<Analytics
  title={title}
  description={description}
  pageLabel="Analytics"
  path="/analytics/"
  ogImage={ogPath(hero, heroCard)}
>
  <main class="wrap">
    <p class="eyebrow">Research &amp; Analysis</p>
    <h1 class="hd">The charts behind <span class="dim">the reporting.</span></h1>
    <p class="lede">
      Every Boardroom Wire investigation is built on primary documents. These are the
      dashboards that came out of them — interactive, individually citable, and marked
      throughout with where each number came from.
    </p>

    <div class="rule"></div>

    <div class="collections">
      {collections.map((c) => (
        <a class="coll" href={`/analytics/${c.slug}/`}>
          <div class="coll-img">
            <img
              src={thumbPath(c, heroCard)}
              alt=""
              width="640" height="360"
              loading="eager" decoding="async"
            />
          </div>
          <div class="coll-body">
            <p class="coll-kicker">{c.kicker} · {fmtDate(c.published)}</p>
            <h2>{c.title}</h2>
            <p class="coll-sum">{c.summary}</p>
            <span class="coll-cta">Open the collection →</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Analytics>

<style>
  .collections { display: grid; gap: 26px; }

  a.coll {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    text-decoration: none;
    color: var(--white);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 179, 71, 0.03), transparent 60%);
    padding: 26px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.25s ease;
  }
  a.coll:hover {
    border-color: rgba(255, 179, 71, 0.55);
    box-shadow: 0 0 26px rgba(255, 179, 71, 0.12);
    transform: translateY(-3px);
  }

  .coll-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--black-soft);
  }
  .coll-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  a.coll:hover .coll-img img { transform: scale(1.04); }

  .coll-kicker {
    font-family: var(--mono);
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--amber);
  }
  .coll-body h2 {
    font-size: clamp(22px, 2.4vw, 30px); font-weight: 800;
    letter-spacing: -0.015em; line-height: 1.18; margin: 12px 0 0;
  }
  a.coll:hover .coll-body h2 { color: var(--amber-bright); }
  .coll-sum {
    font-size: 15px; line-height: 1.6; color: #9C978B; margin: 14px 0 0;
    max-width: 62ch;
  }
  .coll-cta {
    display: inline-block; margin-top: 18px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold-bright);
  }

  @media (max-width: 860px) {
    a.coll { grid-template-columns: 1fr; gap: 20px; padding: 18px; }
  }
</style>
