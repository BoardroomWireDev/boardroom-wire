---
/**
 * /analytics/<collection>/ — a collection's index: every dashboard in video
 * order, with the same source chip that is baked into the frame itself.
 */
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import { collections, chipLabel, heroOf, thumbPath, ogPath } from '../../../data/analytics';
import type { Collection } from '../../../data/analytics';

export function getStaticPaths() {
  return collections.map((c) => ({ params: { collection: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Collection };

const title = `${c.title} · Boardroom Wire`;
const hero = heroOf(c);
const hasEstimates = c.dashboards.some((d) => d.source === 'estimate');

const articles = await getCollection('articles', (a) =>
  a.data.collection === c.slug && (import.meta.env.PROD ? !a.data.draft : true));
const article = articles[0];
---

<Site
  title={title}
  description={c.summary}
  pageLabel="Analytics"
  path={`/analytics/${c.slug}/`}
  ogImage={ogPath(c, hero)}
>
  <main class="wrap">
    <a class="crumb" href="/analytics/">← All analysis</a>

    <p class="eyebrow">{c.kicker}</p>
    <h1 class="hd">{c.headline.lead} <span class="dim">{c.headline.dim}</span></h1>
    <p class="lede">{c.summary}</p>

    {article && (
      <a class="read" href={`/wire/${article.id}/`}>
        <span class="read-k">Read the article</span>
        <span class="read-t">{article.data.title} →</span>
      </a>
    )}

    <!-- Methodology. The chips are on every frame; this explains them once. -->
    <section class="method" aria-label="Methodology">
      <h2>How to read these</h2>
      <p>
        Every dashboard carries a source chip in its lower-left corner, and the
        distinction is deliberate.
      </p>
      <ul>
        <li>
          <span class="chip primary">{chipLabel(c, 'primary')}</span>
          <span>{c.method.primary}</span>
        </li>
        <li>
          <span class="chip reported">Reported</span>
          <span>{c.method.reported}</span>
        </li>
        {hasEstimates && c.method.estimate && (
          <li>
            <span class="chip estimate">Estimate</span>
            <span>{c.method.estimate}</span>
          </li>
        )}
      </ul>
      {c.method.caveat && <p class="caveat">{c.method.caveat}</p>}
    </section>

    <div class="rule"></div>

    <div class="a-grid">
      {c.dashboards.map((d, i) => (
        <a class="a-card" href={`/analytics/${c.slug}/${d.slug}/`}>
          <div class="thumb">
            <span class="num">{String(d.n).padStart(2, '0')}</span>
            {d.key && <span class="keyflag">Key chart</span>}
            <img
              src={thumbPath(c, d)}
              alt={`${d.title} — dashboard preview`}
              width="640" height="360"
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <h3>{d.title}</h3>
          <p>{d.blurb}</p>
          <span class="foot">
            <span class="sec">{d.section}</span>
            <span class={`chip ${d.source}`}>{chipLabel(c, d.source)}</span>
          </span>
        </a>
      ))}
    </div>
  </main>
</Site>

<style>
  .read {
    display: inline-flex; flex-direction: column; gap: 6px;
    margin-top: 22px; padding: 16px 20px;
    text-decoration: none; color: var(--white);
    border: 1px solid var(--line); border-left: 2px solid var(--gold);
    background: rgba(212, 175, 55, 0.04);
    transition: border-color 0.2s, background 0.2s;
  }
  .read:hover { border-color: rgba(212, 175, 55, 0.5); background: rgba(212, 175, 55, 0.07); }
  .read-k {
    font-family: var(--mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold);
  }
  .read-t { font-size: 16px; font-weight: 700; line-height: 1.3; }

  .method {
    margin-top: 40px;
    border: 1px solid var(--line);
    border-left: 2px solid rgba(255, 179, 71, 0.5);
    padding: 26px 28px;
    background: linear-gradient(180deg, rgba(255, 179, 71, 0.025), transparent 70%);
  }
  .method h2 {
    font-size: 12px; font-weight: 700; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--amber-bright); margin: 0 0 14px;
  }
  .method p { font-size: 14.5px; line-height: 1.6; color: #A9A497; margin: 0; }
  .method ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 14px; }
  .method li {
    display: grid; grid-template-columns: 130px minmax(0, 1fr);
    gap: 16px; align-items: start;
    font-size: 14.5px; line-height: 1.6; color: #A9A497;
  }
  .method .caveat {
    margin-top: 18px; padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 13.5px; color: #8E8A7E;
  }
  @media (max-width: 640px) {
    .method { padding: 20px 18px; }
    .method li { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
