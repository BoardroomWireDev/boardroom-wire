---
/**
 * /analytics/<collection>/<slug>/ — one page per dashboard.
 * The embed itself is the shared DashboardEmbed component.
 */
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import DashboardEmbed from '../../../components/DashboardEmbed.astro';
import { collections, chipLabel, ogPath } from '../../../data/analytics';
import type { Collection, Dashboard } from '../../../data/analytics';

export function getStaticPaths() {
  return collections.flatMap((c) =>
    c.dashboards.map((d) => ({ params: { collection: c.slug, slug: d.slug }, props: { c, d } })));
}

const { c, d } = Astro.props as { c: Collection; d: Dashboard };

const idx = c.dashboards.findIndex((x) => x.slug === d.slug);
const prev = idx > 0 ? c.dashboards[idx - 1] : null;
const next = idx < c.dashboards.length - 1 ? c.dashboards[idx + 1] : null;

const title = `${d.title} · ${c.headline.lead} · Boardroom Wire`;

const articles = await getCollection('articles', (a) =>
  a.data.collection === c.slug && (import.meta.env.PROD ? !a.data.draft : true));
const article = articles[0];
---

<Site
  title={title}
  description={d.blurb}
  pageLabel="Analytics"
  path={`/analytics/${c.slug}/${d.slug}/`}
  ogImage={ogPath(c, d)}
>
  <main class="wrap">
    <a class="crumb" href={`/analytics/${c.slug}/`}>← {c.headline.lead}</a>

    <div class="head">
      <div>
        <p class="eyebrow">
          {String(d.n).padStart(2, '0')} / {c.dashboards.length} · {d.section}
        </p>
        <h1 class="hd">{d.title}</h1>
      </div>
      <span class={`chip ${d.source}`}>{chipLabel(c, d.source)}</span>
    </div>

    <p class="lede">{d.blurb}</p>

    {article && (
      <a class="from" href={`/wire/${article.id}/#${d.slug}`}>
        <span class="from-k">From the article</span>
        <span class="from-t">{article.data.title} →</span>
      </a>
    )}

    <DashboardEmbed collection={c.slug} slug={d.slug} showAbout={false} mode="live" />

    <nav class="pager" aria-label="Other dashboards">
      {prev
        ? <a class="pg prev" href={`/analytics/${c.slug}/${prev.slug}/`}>
            <span class="pg-k">← Previous</span>
            <span class="pg-t">{prev.title}</span>
          </a>
        : <span></span>}
      {next
        ? <a class="pg next" href={`/analytics/${c.slug}/${next.slug}/`}>
            <span class="pg-k">Next →</span>
            <span class="pg-t">{next.title}</span>
          </a>
        : <span></span>}
    </nav>
  </main>
</Site>

<style>
  .head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .head .hd { font-size: clamp(26px, 3.6vw, 44px); }

  .from {
    display: inline-flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    margin-top: 18px; text-decoration: none; color: var(--white);
  }
  .from-k {
    font-family: var(--mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold);
  }
  .from-t { font-size: 14px; font-weight: 600; }
  .from:hover .from-t { color: var(--amber-bright); }

  /* ---- pager ---- */
  .pager {
    display: flex; justify-content: space-between; gap: 18px;
    margin-top: 44px; padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  a.pg { text-decoration: none; color: var(--white); max-width: 46%; }
  a.pg.next { text-align: right; margin-left: auto; }
  .pg-k {
    display: block; font-family: var(--mono);
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--white-dim);
  }
  .pg-t {
    display: block; margin-top: 7px;
    font-size: 15px; font-weight: 700; line-height: 1.3;
  }
  a.pg:hover .pg-t { color: var(--amber-bright); }
</style>
