---
/**
 * Site shell for every page that is not one of the three original standalone
 * documents (index, about, videos — which keep their inline styles).
 *
 * Used by /analytics/ and /wire/. Carries the ticker, the header, the footer,
 * the shared tokens and page furniture, the SEO head (canonical, Open Graph,
 * Twitter, optional Article metadata and JSON-LD) and the YouTube hydration
 * script for the ticker.
 *
 * Chrome, tokens and type are copied from videos.astro so these sections are
 * visually continuous with the rest of the site.
 */
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title: string;
  description: string;
  /** Small amber label sitting inline with the wordmark. */
  pageLabel: string;
  /** Absolute or root-relative path to the OG image. */
  ogImage?: string;
  /** Canonical path, e.g. "/analytics/". */
  path: string;
  ogType?: 'website' | 'article';
  /** ISO timestamps; emitted as article:published_time / article:modified_time. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Serialised into a JSON-LD script tag. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Pipeline slug of the video this page belongs to (keys its page views). */
  video?: string;
}

const {
  title, description, pageLabel, ogImage, path,
  ogType = 'website', publishedTime, modifiedTime, jsonLd, noindex = false, video,
} = Astro.props;

---

<!doctype html>
<html lang="en">
<head>
  <SeoHead title={title} description={description} path={path} ogImage={ogImage}
    ogType={ogType} publishedTime={publishedTime} modifiedTime={modifiedTime} jsonLd={jsonLd} noindex={noindex} video={video} />

  <style is:global>
    :root {
      --black:       #000000;
      --black-soft:  #0A0A0A;
      --line:        #1A1A1A;
      --white:       #F5F1E5;
      --white-dim:   #888173;
      --gold:        #D4AF37;
      --gold-bright: #F2CB52;
      --amber:        #FFB347;
      --amber-bright: #FFC97A;
      --amber-glow:   rgba(255, 179, 71, 0.4);
      --display: 'Inter', system-ui, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--black);
      color: var(--white);
      font-family: var(--display);
      overflow-x: hidden;
      min-height: 100vh;
    }

    body::before {
      content: "";
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 1000;
      opacity: 0.04;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/%3E%3C/svg%3E");
    }

    /* ============ TICKER ============ */
    .ticker {
      display: flex; align-items: stretch; height: 54px;
      border-bottom: 1px solid var(--line);
      background: var(--black);
      position: relative; z-index: 10;
    }
    .ticker-label {
      background: var(--gold); color: var(--black);
      font-size: 13px; font-weight: 800; letter-spacing: 0.24em;
      padding: 0 22px;
      display: flex; align-items: center; gap: 12px;
      text-transform: uppercase;
      box-shadow: 0 0 14px var(--amber-glow);
    }
    .ticker-stats {
      flex: 1; overflow: hidden; position: relative;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
    }
    .ticker-track {
      display: flex; align-items: center; gap: 56px;
      height: 100%; width: max-content; padding-left: 32px;
      animation: ticker-scroll 28s linear infinite;
    }
    .ticker:hover .ticker-track,
    .ticker:focus-within .ticker-track { animation-play-state: paused; }
    @keyframes ticker-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .stat {
      font-size: 13px; letter-spacing: 0.18em; color: var(--white-dim);
      text-transform: uppercase; font-weight: 500;
      display: flex; align-items: baseline; gap: 12px;
      white-space: nowrap; flex-shrink: 0;
    }
    .stat .v { color: var(--white); font-weight: 600; font-variant-numeric: tabular-nums; }
    .stat .sep { color: var(--line); margin-left: 56px; }

    /* ============ HEADER ============ */
    header.top {
      padding: 28px 40px 0;
      position: relative; z-index: 5;
      display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    }
    .home-link {
      font-weight: 900; font-size: 22px; letter-spacing: 0.02em; line-height: 1;
      color: var(--white); text-decoration: none; user-select: none;
    }
    .home-link .wire { color: var(--gold-bright); }
    .home-link:hover .wire { color: var(--gold); }
    .page-label {
      font-size: 13px; font-weight: 700; letter-spacing: 0.32em;
      text-transform: uppercase; color: var(--amber-bright);
      text-shadow: 0 0 12px rgba(255, 179, 71, 0.5);
    }

    /* CRT phosphor atmosphere — same overlay as /about/ and /videos/. */
    .page-fx {
      position: fixed; inset: 0; pointer-events: none; z-index: 1;
      background:
        radial-gradient(circle at 0% 0%,   rgba(255, 179, 71, 0.14), transparent 35%),
        radial-gradient(circle at 100% 0%, rgba(255, 179, 71, 0.10), transparent 35%),
        radial-gradient(circle at 0% 100%, rgba(255, 179, 71, 0.10), transparent 35%),
        radial-gradient(circle at 100% 100%, rgba(255, 179, 71, 0.14), transparent 35%),
        repeating-linear-gradient(to bottom,
          rgba(255, 179, 71, 0.035) 0, rgba(255, 179, 71, 0.035) 1px,
          transparent 1px, transparent 4px);
    }

    /* ============ SHARED PAGE FURNITURE ============ */
    main.wrap {
      max-width: 1280px; margin: 0 auto;
      padding: 48px 24px 72px;
      position: relative; z-index: 5;
    }
    .eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: 0.32em;
      text-transform: uppercase; color: var(--amber-bright);
      text-shadow: 0 0 12px rgba(255, 179, 71, 0.5);
    }
    h1.hd {
      font-size: clamp(30px, 4.4vw, 52px); font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.08; margin: 16px 0 0;
    }
    h1.hd .dim { color: var(--white-dim); font-weight: 600; }
    p.lede {
      max-width: 68ch; margin-top: 18px;
      font-size: 17px; line-height: 1.62; color: #B8B2A4;
    }
    .rule { height: 1px; background: var(--line); margin: 40px 0; }

    .crumb {
      display: inline-flex; align-items: center; gap: 10px;
      margin-bottom: 26px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--white-dim);
      text-decoration: none; transition: color 0.18s;
    }
    .crumb:hover { color: var(--gold-bright); }

    /* ============ SOURCE CHIP ============ */
    /* Mirrors the chip baked into every dashboard frame: solid gold = primary,
       dashed amber = reported, dotted grey with a hollow dot = estimate. */
    .chip {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 5px 11px; border-radius: 3px;
      font-family: var(--mono); font-size: 10px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      white-space: nowrap;
    }
    .chip::before { content: ""; width: 5px; height: 5px; border-radius: 50%; }
    .chip.primary {
      color: var(--gold); border: 1px solid rgba(212, 175, 55, 0.45);
      background: rgba(212, 175, 55, 0.05);
    }
    .chip.primary::before { background: var(--gold); box-shadow: 0 0 6px var(--amber-glow); }
    .chip.reported {
      color: var(--amber); border: 1px dashed rgba(255, 179, 71, 0.42);
      background: rgba(255, 179, 71, 0.04);
    }
    .chip.reported::before { background: var(--amber); box-shadow: 0 0 6px var(--amber-glow); }
    .chip.estimate {
      color: var(--white-dim); border: 1px dotted rgba(245, 241, 229, 0.38);
      background: rgba(245, 241, 229, 0.03);
    }
    .chip.estimate::before { background: transparent; border: 1px solid rgba(245, 241, 229, 0.5); }
    .chip.illustration {
      color: var(--white-dim); border: 1px solid rgba(245, 241, 229, 0.22);
      background: transparent;
    }
    .chip.illustration::before { display: none; }

    /* ============ CARDS ============ */
    .a-grid {
      display: grid; gap: 22px;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
    a.a-card {
      display: flex; flex-direction: column; gap: 12px;
      text-decoration: none; color: var(--white);
      transition: transform 0.25s ease;
    }
    a.a-card:hover { transform: translateY(-4px); }
    .a-card .thumb {
      position: relative; aspect-ratio: 16 / 9; overflow: hidden;
      background: var(--black-soft); border: 1px solid var(--line);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    a.a-card:hover .thumb {
      border-color: var(--amber);
      box-shadow: 0 0 16px rgba(255, 179, 71, 0.3);
    }
    .a-card .thumb img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.5s ease;
    }
    a.a-card:hover .thumb img { transform: scale(1.04); }
    .a-card .num {
      position: absolute; left: 0; top: 0; z-index: 2;
      font-family: var(--mono); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; color: var(--black);
      background: var(--gold-bright); padding: 5px 10px;
    }
    .a-card h3 {
      font-size: 17px; font-weight: 700; line-height: 1.28;
      letter-spacing: -0.01em; margin: 0;
    }
    a.a-card:hover h3 { color: var(--amber-bright); }
    .a-card p {
      font-size: 13.5px; line-height: 1.5; color: #9C978B; margin: 0;
    }
    .a-card .foot {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin-top: 2px;
    }
    .a-card .sec {
      font-family: var(--mono); font-size: 10px; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--white-dim);
    }

    /* ============ FOOTER ============ */
    footer.tail {
      border-top: 1px solid var(--line);
      padding: 28px 48px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      font-size: 11px; font-weight: 500; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--white-dim);
      position: relative; z-index: 5;
    }
    footer.tail a { color: inherit; text-decoration: none; transition: color 0.18s; }
    footer.tail a:hover { color: var(--gold-bright); }
    footer.tail .links { display: flex; gap: 22px; flex-wrap: wrap; }

    @media (max-width: 720px) {
      /* A long page label plus an unwrapped flex header was widening the whole
         document past the viewport — every block below it then inherited that
         width. */
      header.top { padding: 20px 24px 0; flex-wrap: wrap; gap: 10px; }
      .page-label { font-size: 11px; letter-spacing: 0.22em; }
      .home-link { font-size: 18px; }
      .ticker { height: 46px; }
      .ticker-track { gap: 36px; padding-left: 20px; }
      .stat { font-size: 11px; letter-spacing: 0.12em; gap: 8px; }
      .stat .sep { margin-left: 36px; }
      .ticker-label { font-size: 11px; padding: 0 14px; gap: 8px; }
      main.wrap { padding: 32px 18px 56px; }
      .a-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
    }
    @media (max-width: 540px) {
      footer.tail { padding: 20px 24px; flex-direction: column; align-items: flex-start; gap: 12px; }
      .a-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0s !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0s !important;
      }
      /* Brand-critical motion exempted, same call as the other pages. */
      .ticker-track { animation: ticker-scroll 28s linear infinite !important; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page-fx" aria-hidden="true"></div>

  <div class="ticker">
    <div class="ticker-label">
      <span>Live Wire</span>
    </div>
    <div class="ticker-stats" aria-label="Live channel statistics">
      <div class="ticker-track">
        <div class="stat">Videos <span class="v" data-stat="videos">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Subscribers <span class="v" data-stat="subs">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Total Views <span class="v" data-stat="views">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Top Episode <span class="v" data-stat="top">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat">Newest <span class="v" data-stat="newest">—</span><span class="sep" aria-hidden="true">·</span></div>
        <div class="stat" aria-hidden="true">Videos <span class="v" data-stat="videos">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Subscribers <span class="v" data-stat="subs">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Total Views <span class="v" data-stat="views">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Top Episode <span class="v" data-stat="top">—</span><span class="sep">·</span></div>
        <div class="stat" aria-hidden="true">Newest <span class="v" data-stat="newest">—</span><span class="sep">·</span></div>
      </div>
    </div>
  </div>

  <header class="top">
    <a href="/" class="home-link" aria-label="Boardroom Wire, home">
      BOARDROOM<span class="wire">WIRE</span>
    </a>
    <span class="page-label">{pageLabel}</span>
  </header>

  <slot />

  <footer class="tail">
    <span>© {new Date().getFullYear()} Boardroom Wire</span>
    <span class="links">
      <a href="/wire/">Wire</a>
      <a href="/videos/">Videos</a>
      <a href="/about/">About</a>
      <a href="https://boardroomwire.substack.com/" target="_blank" rel="noopener">Substack</a>
      <a href="/privacy/">Privacy</a>
      <a href="/">← Home</a>
    </span>
  </footer>

  <script>
    import { fetchChannelData, fmt, daysAgo } from '../lib/youtube';

    const setStat = (name: string, value: string) => {
      document.querySelectorAll(`[data-stat="${name}"]`).forEach((el) => {
        el.textContent = value;
      });
    };

    async function hydrate() {
      const data = await fetchChannelData();
      if (!data) return; // ticker shows em-dashes
      setStat('videos', fmt(data.videos));
      setStat('subs',   fmt(data.subs));
      setStat('views',  fmt(data.views));
      setStat('top',    data.topVideo ? `${fmt(data.topVideo.views)} views` : '—');
      setStat('newest', data.newest ? daysAgo(data.newest.publishedAt) : '—');
    }
    hydrate();
    setInterval(hydrate, 5 * 60_000);
  </script>
</body>
</html>
